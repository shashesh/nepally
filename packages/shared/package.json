{
  "name": "@nepally/shared",
  "version": "1.0.0",
  "description": "Shared TypeScript code for Nepally mobile and web apps",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "node ../../node_modules/@typescript/native/bin/tsc",
    "dev": "node ../../node_modules/@typescript/native/bin/tsc --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint src",
    "type-check": "node ../../node_modules/@typescript/native/bin/tsc --noEmit",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.43.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^24.13.0",
    "@typescript/native": "npm:typescript@^7.0.2",
    "typescript": "npm:@typescript/typescript6@^6.0.2"
  }
}
