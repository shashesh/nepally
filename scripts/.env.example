# Supabase — get from https://supabase.com → Project Settings → API
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Census Bureau API — register at https://api.census.gov/data/key_signup.html
CENSUS_API_KEY=your-census-api-key

# HUD User API — register at https://www.huduser.gov/hudapi/public/register
HUD_API_TOKEN=your-hud-api-token
