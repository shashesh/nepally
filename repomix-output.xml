  min-height: 6rem;
  font-family: inherit;
  border: 1px solid rgba(0, 0, 0, 0.42);
  border-radius: 4px;
  padding: 12px;
}

.wmd-textarea:focus {
  border: 2px solid #6200ee;
  margin: -1px;
}

.wmd-select {
  cursor: pointer;
}

/* Checkboxes and Radios - Material Style */
.wmd-checkbox, .wmd-radio {
  display: flex;
  align-items: center;
  gap: 0.5rem;
  margin: 0.5rem 0;
  cursor: pointer;
}

.wmd-checkbox input[type="checkbox"],
