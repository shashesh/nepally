<file path=".github/workflows/ci-job.yml">
name: CI Job Template

on:
  workflow_call:
    inputs:
      command:
        description: NPM command to execute
        required: true
        type: string
      ref:
        description: Optional git ref to checkout
        required: false
        default: ''
        type: string
      install_playwright:
        description: Whether to install Playwright browsers
        required: false
        default: false
        type: boolean
      with_supabase_env:
        description: Whether to inject Supabase env vars for the command
        required: false
        default: false
        type: boolean

jobs:
  run:
    runs-on: ubuntu-latest
    timeout-minutes: 20

    steps:
      - name: Checkout
        if: inputs.ref == ''
        uses: actions/checkout@v4

      - name: Checkout selected ref
        if: inputs.ref != ''
        uses: actions/checkout@v4
        with:
          ref: ${{ inputs.ref }}

      - name: Setup Node
        uses: actions/setup-node@v4
        with:
          node-version: 20
          cache: npm

      - name: Install dependencies
        run: npm ci

      - name: Install Playwright browsers
        if: inputs.install_playwright
        run: npm exec --workspace=apps/web playwright install --with-deps

      - name: Run command
        if: inputs.with_supabase_env == false
        run: ${{ inputs.command }}

      - name: Run command with Supabase env
        if: inputs.with_supabase_env
        run: ${{ inputs.command }}
        env:
          NEXT_PUBLIC_SUPABASE_URL: ${{ vars.NEXT_PUBLIC_SUPABASE_URL != '' && vars.NEXT_PUBLIC_SUPABASE_URL || 'https://example.supabase.co' }}
          NEXT_PUBLIC_SUPABASE_ANON_KEY: ${{ secrets.NEXT_PUBLIC_SUPABASE_ANON_KEY != '' && secrets.NEXT_PUBLIC_SUPABASE_ANON_KEY || 'ci-placeholder-anon-key' }}
</file>

<file path=".github/workflows/ci-manual.yml">
name: CI Manual

on:
  workflow_dispatch:
    inputs:
      target_branch:
        description: Branch to run the full CI pipeline on
        required: true
        default: master

jobs:
  lint:
    name: Lint
    uses: ./.github/workflows/ci-job.yml
    with:
      ref: ${{ github.event.inputs.target_branch }}
      command: npm run lint

  lint_guards:
    name: Lint guards
    uses: ./.github/workflows/ci-job.yml
    with:
      ref: ${{ github.event.inputs.target_branch }}
      command: npm run lint:guards

  type_check:
    name: Type check
    uses: ./.github/workflows/ci-job.yml
    with:
      ref: ${{ github.event.inputs.target_branch }}
      command: npm run type-check

  unit_tests:
    name: Unit tests
    uses: ./.github/workflows/ci-job.yml
    with:
      ref: ${{ github.event.inputs.target_branch }}
      command: npm run test:ci

  coverage:
    name: Coverage
    uses: ./.github/workflows/ci-job.yml
    with:
      ref: ${{ github.event.inputs.target_branch }}
      command: npm run test:coverage:ci

  web_e2e:
    name: Web E2E tests
    uses: ./.github/workflows/ci-job.yml
    with:
      ref: ${{ github.event.inputs.target_branch }}
      command: npm run test:e2e --workspace=apps/web
      install_playwright: true
      with_supabase_env: true
    secrets: inherit
</file>

