  margin: 24px 0;
}

/* Table */
.wmd-table {
  width: 100%;
  border-collapse: separate;
  border-spacing: 0;
  border: 3px solid #000;
  border-radius: 8px;
  margin: 16px 0;
  overflow: hidden;
}

.wmd-table th, .wmd-table td {
  border: 2px solid #666;
  padding: 8px 12px;
  text-align: left;
}

.wmd-table th {
  background: #DDD;
  font-weight: bold;
}

/* Table cell alignment - more specific to override th/td defaults */
