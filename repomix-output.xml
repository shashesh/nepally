    <td class="wmd-table-cell wmd-align-left">3:1</td>
  </tr>
    <tr>
    <td class="wmd-table-cell wmd-align-left">Interactive elements</td>
    <td class="wmd-table-cell wmd-align-left">3:1</td>
  </tr>
  </tbody>
</table>
<h4 class="wmd-h4">Touch Targets</h4>
<table class="wmd-table">
  <thead>
    <tr>
      <th class="wmd-table-cell wmd-align-left">Platform</th>
    <th class="wmd-table-cell wmd-align-left">Minimum</th>
    <th class="wmd-table-cell wmd-align-left">Recommended</th>
    </tr>
  </thead>
