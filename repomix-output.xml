  vertical-align: middle;
  margin: 0 0.2em;
}

/* Navigation */
.wmd-nav {
  background: #87CEEB;
  border: 3px solid #4682B4;
  border-radius: 8px;
  padding: 12px 16px;
  margin: 16px 0;
  box-shadow: 3px 3px 0 rgba(0,0,0,0.15);
}

.wmd-nav-content {
  display: flex;
  align-items: center;
  gap: 16px;
  flex-wrap: wrap;
}

.wmd-brand {
  font-weight: bold;
  font-size: 1.2em;
  margin-right: auto;
}

.wmd-nav-item {
  display: inline-block;
  color: #000;
  text-decoration: none;
  font-weight: bold;
  padding: 6px 14px;
  background: #fff;
  border: 2px solid #000;
  border-radius: 6px;
  box-shadow: 2px 2px 0 rgba(0,0,0,0.15);
  transform: rotate(0.3deg);
  transition: all 0.1s;
}

.wmd-nav-item:hover {
  transform: rotate(0.3deg) translateY(-1px);
  box-shadow: 2px 3px 0 rgba(0,0,0,0.15);
  background: #f8f8f8;
}

.wmd-nav .wmd-button {
  margin: 0;
}

/* Grid */
.wmd-grid {
  display: grid;
  grid-template-columns: repeat(var(--grid-columns, 3), 1fr);
  gap: 24px;
  margin: 24px 0;
}

.wmd-grid-2 { grid-template-columns: repeat(2, 1fr); }
.wmd-grid-3 { grid-template-columns: repeat(3, 1fr); }
.wmd-grid-4 { grid-template-columns: repeat(4, 1fr); }

.wmd-grid-item {
  background: #fff;
  border: 2px solid #666;
  border-radius: 8px;
  padding: 16px;
  box-shadow: 2px 2px 0 rgba(0,0,0,0.1);
  transform: rotate(0.5deg);
}

.wmd-grid-item:nth-child(even) {
  transform: rotate(-0.5deg);
}

/* Lists */
.wmd-list {
  margin: 12px 0;
  padding-left: 24px;
}

.wmd-list-item {
  margin: 4px 0;
}

/* Blockquote */
.wmd-blockquote {
  border-left: 4px solid #666;
  padding-left: 16px;
  margin: 16px 0;
  font-style: italic;
  color: #555;
}

/* Code */
.wmd-code-inline {
  background: #FFF3CD;
  border: 1px solid #FFC107;
  border-radius: 3px;
  padding: 2px 6px;
  font-family: 'Courier New', monospace;
  font-size: 0.9em;
}

.wmd-code-block {
  background: #FFF3CD;
  border: 2px solid #FFC107;
  border-radius: 6px;
  padding: 12px;
  margin: 12px 0;
  overflow-x: auto;
}

.wmd-code-block code {
  font-family: 'Courier New', monospace;
  font-size: 0.9em;
}

/* Separator */
.wmd-separator {
  border: none;
  border-top: 3px dashed #666;
  margin: 24px 0;
}

/* Table */
.wmd-table {
  width: 100%;
  border-collapse: separate;
  border-spacing: 0;
  border: 3px solid #000;
  border-radius: 8px;
  margin: 16px 0;
  overflow: hidden;
}

.wmd-table th, .wmd-table td {
  border: 2px solid #666;
  padding: 8px 12px;
  text-align: left;
}

.wmd-table th {
  background: #DDD;
  font-weight: bold;
}

/* Table cell alignment - more specific to override th/td defaults */
.wmd-table .wmd-align-left {
  text-align: left !important;
}

.wmd-table .wmd-align-center {
  text-align: center !important;
}

.wmd-table .wmd-align-right {
  text-align: right !important;
}

/* State Containers */
.wmd-container-loading-state {
  background: #fff;
  border: 2px solid #87CEEB;
  border-radius: 8px;
  padding: 32px;
  margin: 16px 0;
  text-align: center;
  position: relative;
}

.wmd-container-loading-state::before {
  content: '⟳';
  display: block;
  font-size: 48px;
  margin-bottom: 16px;
  animation: spin 1.5s linear infinite;
  transform-origin: center;
}

.wmd-container-empty-state {
  background: #f5f5f5;
  border: 2px dashed #999;
  border-radius: 8px;
  padding: 48px 32px;
  margin: 16px 0;
  text-align: center;
  color: #666;
}

.wmd-container-empty-state::before {
  content: '📭';
  display: block;
  font-size: 64px;
  margin-bottom: 16px;
  opacity: 0.5;
}

.wmd-container-error-state {
  background: #FFE6E6;
  border: 3px solid #DC143C;
  border-radius: 8px;
  padding: 32px;
  margin: 16px 0;
  text-align: center;
}

.wmd-container-error-state::before {
  content: '⚠️';
  display: block;
  font-size: 48px;
  margin-bottom: 16px;
}

/* Responsive */
@media (max-width: 768px) {
  .wmd-grid {
    grid-template-columns: 1fr !important;
  }

  .wmd-nav-content {
    flex-direction: column;
    align-items: stretch;
  }

  .wmd-brand {
    margin-right: 0;
  }
}

@keyframes loading {
  0%, 100% { opacity: 1; }
  50% { opacity: 0.5; }
}

@keyframes spin {
  from { transform: rotate(0deg); }
  to { transform: rotate(360deg); }
}

