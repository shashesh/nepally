<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>wiremd Mockup</title>
  <style>

/* Material Design Inspired Style */
body {
  font-family: Roboto, -apple-system, BlinkMacSystemFont, "Segoe UI", "Helvetica Neue", Arial, sans-serif;
  background: #fafafa;
  color: rgba(0, 0, 0, 0.87);
  line-height: 1.5;
  margin: 0;
  padding: 20px;
}

/* Typography - Material Design Type Scale */
.wmd-h1 {
  font-size: 2.125rem;
  font-weight: 400;
  color: rgba(0, 0, 0, 0.87);
  margin: 0 0 1rem 0;
  letter-spacing: 0;
}

.wmd-h2 {
  font-size: 1.5rem;
  font-weight: 500;
  color: rgba(0, 0, 0, 0.87);
  margin: 1.5rem 0 1rem 0;
  letter-spacing: 0.0075em;
}

.wmd-h3 {
  font-size: 1.25rem;
  font-weight: 500;
  color: rgba(0, 0, 0, 0.87);
  margin: 1.25rem 0 0.75rem 0;
  letter-spacing: 0.0125em;
}

.wmd-h4 {
  font-size: 1rem;
  font-weight: 500;
  color: rgba(0, 0, 0, 0.87);
  margin: 1rem 0 0.5rem 0;
  letter-spacing: 0.015em;
}

.wmd-paragraph {
  color: rgba(0, 0, 0, 0.6);
  margin: 0.75rem 0;
  font-size: 1rem;
  letter-spacing: 0.00938em;
}

/* Material Buttons */
.wmd-button {
  padding: 6px 16px;
  border-radius: 4px;
  font-weight: 500;
  font-size: 0.875rem;
  letter-spacing: 0.02857em;
  text-transform: uppercase;
  transition: background-color 250ms cubic-bezier(0.4, 0, 0.2, 1) 0ms,
              box-shadow 250ms cubic-bezier(0.4, 0, 0.2, 1) 0ms,
              border-color 250ms cubic-bezier(0.4, 0, 0.2, 1) 0ms;
  border: none;
  cursor: pointer;
  display: inline-block;
  text-decoration: none;
  background: transparent;
  color: #6200ee;
  position: relative;
  overflow: hidden;
}

.wmd-button::before {
  content: '';
  position: absolute;
  top: 50%;
  left: 50%;
  width: 0;
  height: 0;
  border-radius: 50%;
  background: rgba(98, 0, 238, 0.2);
  transform: translate(-50%, -50%);
  transition: width 0.6s, height 0.6s;
}

.wmd-button:hover::before {
  width: 300px;
  height: 300px;
}

.wmd-button:hover {
  background: rgba(98, 0, 238, 0.04);
}

.wmd-button-primary, .wmd-button.wmd-button-primary {
  background: #6200ee;
  color: white;
  box-shadow: 0px 3px 1px -2px rgba(0,0,0,0.2),
              0px 2px 2px 0px rgba(0,0,0,0.14),
              0px 1px 5px 0px rgba(0,0,0,0.12);
}

.wmd-button-primary::before {
  background: rgba(255, 255, 255, 0.2);
}

.wmd-button-primary:hover, .wmd-button.wmd-button-primary:hover {
  background: #6200ee;
  box-shadow: 0px 2px 4px -1px rgba(0,0,0,0.2),
              0px 4px 5px 0px rgba(0,0,0,0.14),
              0px 1px 10px 0px rgba(0,0,0,0.12);
}

.wmd-button:disabled, .wmd-button[disabled] {
  color: rgba(0, 0, 0, 0.26);
  background: rgba(0, 0, 0, 0.12);
  cursor: not-allowed;
  box-shadow: none;
}

/* Button States */
.wmd-state-loading {
  background: #e8eaf6 !important;
  color: #6200ee !important;
  position: relative;
  padding-left: 2.5rem;
}

.wmd-state-loading::after {
  content: '';
  position: absolute;
  left: 1rem;
  top: 50%;
  transform: translateY(-50%);
  width: 1rem;
  height: 1rem;
  border: 2px solid #6200ee;
  border-top-color: transparent;
  border-radius: 50%;
  animation: spin 0.8s linear infinite;
}

.wmd-state-error {
  background: #b00020 !important;
  color: white !important;
}

.wmd-state-success {
  background: #00c853 !important;
  color: white !important;
}

@keyframes spin {
  to { transform: translateY(-50%) rotate(360deg); }
}

/* Material Form Inputs */
.wmd-input, .wmd-textarea, .wmd-select {
  width: 100%;
  padding: 12px;
  border: none;
  border-bottom: 1px solid rgba(0, 0, 0, 0.42);
  font-size: 1rem;
  background: transparent;
  transition: border-color 200ms cubic-bezier(0.4, 0, 0.2, 1) 0ms;
  color: rgba(0, 0, 0, 0.87);
}

.wmd-input:focus, .wmd-textarea:focus, .wmd-select:focus {
  outline: none;
  border-bottom: 2px solid #6200ee;
  margin-bottom: -1px;
}

.wmd-input::placeholder, .wmd-textarea::placeholder {
  color: rgba(0, 0, 0, 0.42);
}

.wmd-input[disabled], .wmd-input.wmd-state-disabled,
.wmd-textarea[disabled], .wmd-textarea.wmd-state-disabled,
.wmd-select[disabled], .wmd-select.wmd-state-disabled {
  color: rgba(0, 0, 0, 0.38);
  cursor: not-allowed;
  background: rgba(0, 0, 0, 0.02);
  border-bottom-color: rgba(0, 0, 0, 0.26);
}

.wmd-textarea {
  resize: vertical;
  min-height: 6rem;
  font-family: inherit;
  border: 1px solid rgba(0, 0, 0, 0.42);
  border-radius: 4px;
  padding: 12px;
}

.wmd-textarea:focus {
  border: 2px solid #6200ee;
  margin: -1px;
}

.wmd-select {
  cursor: pointer;
}

/* Checkboxes and Radios - Material Style */
.wmd-checkbox, .wmd-radio {
  display: flex;
  align-items: center;
  gap: 0.5rem;
  margin: 0.5rem 0;
  cursor: pointer;
}

.wmd-checkbox input[type="checkbox"],
.wmd-radio input[type="radio"] {
  width: 18px;
  height: 18px;
  cursor: pointer;
  accent-color: #6200ee;
}

/* Material Cards - Elevation System */
.wmd-container-card {
  background: white;
  border-radius: 4px;
  box-shadow: 0px 2px 1px -1px rgba(0,0,0,0.2),
              0px 1px 1px 0px rgba(0,0,0,0.14),
              0px 1px 3px 0px rgba(0,0,0,0.12);
  padding: 16px;
  margin: 16px 0;
  transition: box-shadow 300ms cubic-bezier(0.4, 0, 0.2, 1) 0ms;
}

.wmd-container-card:hover {
  box-shadow: 0px 3px 3px -2px rgba(0,0,0,0.2),
              0px 3px 4px 0px rgba(0,0,0,0.14),
              0px 1px 8px 0px rgba(0,0,0,0.12);
}

.wmd-container-hero {
  background: linear-gradient(135deg, #6200ee 0%, #3700b3 100%);
  color: white;
  border-radius: 4px;
  padding: 48px 24px;
  margin: 24px 0;
  text-align: center;
  box-shadow: 0px 3px 5px -1px rgba(0,0,0,0.2),
              0px 6px 10px 0px rgba(0,0,0,0.14),
              0px 1px 18px 0px rgba(0,0,0,0.12);
}

.wmd-container-hero .wmd-h1,
.wmd-container-hero .wmd-h2,
.wmd-container-hero .wmd-h3,
.wmd-container-hero .wmd-paragraph {
  color: white;
}

.wmd-container-modal {
  background: white;
  border-radius: 4px;
  box-shadow: 0px 11px 15px -7px rgba(0,0,0,0.2),
              0px 24px 38px 3px rgba(0,0,0,0.14),
              0px 9px 46px 8px rgba(0,0,0,0.12);
  padding: 24px;
  margin: 24px auto;
  max-width: 600px;
  position: relative;
}

.wmd-container-footer {
  background: #212121;
  color: rgba(255, 255, 255, 0.87);
  padding: 24px;
  margin-top: 48px;
  border-radius: 4px;
}

.wmd-container-footer .wmd-paragraph,
.wmd-container-footer .wmd-nav-item {
  color: rgba(255, 255, 255, 0.87);
}

.wmd-container-section {
  padding: 24px 0;
  border-bottom: 1px solid rgba(0, 0, 0, 0.12);
}

.wmd-container-section:last-child {
  border-bottom: none;
}

/* Material Alerts */
.wmd-container-alert {
  padding: 12px 16px;
  border-radius: 4px;
  margin: 16px 0;
  display: flex;
  align-items: center;
}

.wmd-container-alert.wmd-warning {
  background: #fff3e0;
  color: #e65100;
}

.wmd-container-alert.wmd-state-error {
  background: #ffebee;
  color: #c62828;
}

