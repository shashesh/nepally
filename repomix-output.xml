.wmd-table {
  width: 100%;
  border-collapse: separate;
  border-spacing: 0;
  border: 3px solid #000;
  border-radius: 8px;
  margin: 16px 0;
  overflow: hidden;
}

.wmd-table th, .wmd-table td {
  border: 2px solid #666;
  padding: 8px 12px;
  text-align: left;
}

.wmd-table th {
  background: #DDD;
  font-weight: bold;
}

/* Table cell alignment - more specific to override th/td defaults */
.wmd-table .wmd-align-left {
  text-align: left !important;
}

.wmd-table .wmd-align-center {
  text-align: center !important;
}

.wmd-table .wmd-align-right {
  text-align: right !important;
}

/* State Containers */
.wmd-container-loading-state {
  background: #fff;
  border: 2px solid #87CEEB;
  border-radius: 8px;
  padding: 32px;
  margin: 16px 0;
  text-align: center;
  position: relative;
}

.wmd-container-loading-state::before {
  content: '⟳';
  display: block;
  font-size: 48px;
  margin-bottom: 16px;
  animation: spin 1.5s linear infinite;
  transform-origin: center;
}

.wmd-container-empty-state {
  background: #f5f5f5;
  border: 2px dashed #999;
  border-radius: 8px;
  padding: 48px 32px;
  margin: 16px 0;
  text-align: center;
  color: #666;
}

.wmd-container-empty-state::before {
  content: '📭';
  display: block;
  font-size: 64px;
  margin-bottom: 16px;
  opacity: 0.5;
}

.wmd-container-error-state {
  background: #FFE6E6;
  border: 3px solid #DC143C;
  border-radius: 8px;
  padding: 32px;
  margin: 16px 0;
  text-align: center;
}

.wmd-container-error-state::before {
  content: '⚠️';
  display: block;
  font-size: 48px;
  margin-bottom: 16px;
}

/* Responsive */
@media (max-width: 768px) {
  .wmd-grid {
    grid-template-columns: 1fr !important;
  }

  .wmd-nav-content {
    flex-direction: column;
    align-items: stretch;
  }

  .wmd-brand {
    margin-right: 0;
  }
}

@keyframes loading {
  0%, 100% { opacity: 1; }
  50% { opacity: 0.5; }
}

@keyframes spin {
  from { transform: rotate(0deg); }
  to { transform: rotate(360deg); }
}

