  <title>wiremd Mockup</title>
  <style>

/* Material Design Inspired Style */
body {
  font-family: Roboto, -apple-system, BlinkMacSystemFont, "Segoe UI", "Helvetica Neue", Arial, sans-serif;
  background: #fafafa;
  color: rgba(0, 0, 0, 0.87);
  line-height: 1.5;
  margin: 0;
  padding: 20px;
}

/* Typography - Material Design Type Scale */
.wmd-h1 {
  font-size: 2.125rem;
  font-weight: 400;
  color: rgba(0, 0, 0, 0.87);
  margin: 0 0 1rem 0;
  letter-spacing: 0;
}

.wmd-h2 {
  font-size: 1.5rem;
  font-weight: 500;
  color: rgba(0, 0, 0, 0.87);
  margin: 1.5rem 0 1rem 0;
  letter-spacing: 0.0075em;
}

.wmd-h3 {
  font-size: 1.25rem;
  font-weight: 500;
  color: rgba(0, 0, 0, 0.87);
  margin: 1.25rem 0 0.75rem 0;
  letter-spacing: 0.0125em;
}

.wmd-h4 {
  font-size: 1rem;
  font-weight: 500;
  color: rgba(0, 0, 0, 0.87);
  margin: 1rem 0 0.5rem 0;
  letter-spacing: 0.015em;
}

.wmd-paragraph {
  color: rgba(0, 0, 0, 0.6);
  margin: 0.75rem 0;
  font-size: 1rem;
  letter-spacing: 0.00938em;
}

/* Material Buttons */
.wmd-button {
  padding: 6px 16px;
  border-radius: 4px;
  font-weight: 500;
  font-size: 0.875rem;
  letter-spacing: 0.02857em;
  text-transform: uppercase;
  transition: background-color 250ms cubic-bezier(0.4, 0, 0.2, 1) 0ms,
              box-shadow 250ms cubic-bezier(0.4, 0, 0.2, 1) 0ms,
              border-color 250ms cubic-bezier(0.4, 0, 0.2, 1) 0ms;
  border: none;
  cursor: pointer;
  display: inline-block;
  text-decoration: none;
  background: transparent;
  color: #6200ee;
  position: relative;
  overflow: hidden;
}

.wmd-button::before {
  content: '';
  position: absolute;
  top: 50%;
  left: 50%;
  width: 0;
  height: 0;
  border-radius: 50%;
  background: rgba(98, 0, 238, 0.2);
  transform: translate(-50%, -50%);
  transition: width 0.6s, height 0.6s;
}

.wmd-button:hover::before {
  width: 300px;
  height: 300px;
}

.wmd-button:hover {
  background: rgba(98, 0, 238, 0.04);
}

.wmd-button-primary, .wmd-button.wmd-button-primary {
  background: #6200ee;
  color: white;
  box-shadow: 0px 3px 1px -2px rgba(0,0,0,0.2),
              0px 2px 2px 0px rgba(0,0,0,0.14),
              0px 1px 5px 0px rgba(0,0,0,0.12);
}

.wmd-button-primary::before {
  background: rgba(255, 255, 255, 0.2);
}

.wmd-button-primary:hover, .wmd-button.wmd-button-primary:hover {
  background: #6200ee;
  box-shadow: 0px 2px 4px -1px rgba(0,0,0,0.2),
              0px 4px 5px 0px rgba(0,0,0,0.14),
              0px 1px 10px 0px rgba(0,0,0,0.12);
}

.wmd-button:disabled, .wmd-button[disabled] {
  color: rgba(0, 0, 0, 0.26);
  background: rgba(0, 0, 0, 0.12);
  cursor: not-allowed;
  box-shadow: none;
}

/* Button States */
.wmd-state-loading {
