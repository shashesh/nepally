  lint:
    name: Lint
    uses: ./.github/workflows/ci-job.yml
    needs:
      - gate
    with:
      command: npm run lint

  lint_guards:
    name: Lint guards
    uses: ./.github/workflows/ci-job.yml
    needs:
      - gate
    with:
      command: npm run lint:guards

  type_check:
    name: Type check
    uses: ./.github/workflows/ci-job.yml
    needs:
      - gate
    with:
      command: npm run type-check

  unit_tests:
    name: Unit tests
    uses: ./.github/workflows/ci-job.yml
    needs:
      - gate
    with:
      command: npm run test:ci

  coverage:
    name: Coverage
    uses: ./.github/workflows/ci-job.yml
    needs:
      - gate
    with:
      command: npm run test:coverage:ci

  web_e2e:
