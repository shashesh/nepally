  </tr>
    <tr>
    <td class="wmd-table-cell wmd-align-left"><code class="wmd-code-inline">signup_google</code></td>
    <td class="wmd-table-cell wmd-align-left">Continue with Google</td>
  </tr>
    <tr>
    <td class="wmd-table-cell wmd-align-left"><code class="wmd-code-inline">signup_phone</code></td>
    <td class="wmd-table-cell wmd-align-left">Continue with Phone Number</td>
  </tr>
    <tr>
    <td class="wmd-table-cell wmd-align-left"><code class="wmd-code-inline">signup_email</code></td>
