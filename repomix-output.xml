    <td class="wmd-table-cell wmd-align-left">NotificationsScreen</td>
  </tr>
    <tr>
    <td class="wmd-table-cell wmd-align-left">Exit — Chat</td>
    <td class="wmd-table-cell wmd-align-left">Tap message notification</td>
    <td class="wmd-table-cell wmd-align-left">MessageThreadScreen</td>
  </tr>
    <tr>
    <td class="wmd-table-cell wmd-align-left">Exit — Post</td>
    <td class="wmd-table-cell wmd-align-left">Tap comment/like notification</td>
    <td class="wmd-table-cell wmd-align-left">PostDetailScreen</td>
  </tr>
    <tr>
    <td class="wmd-table-cell wmd-align-left">Exit — Emergency</td>
    <td class="wmd-table-cell wmd-align-left">Tap emergency notification</td>
