  "title": "Nepali New Year Celebration",
  "event_type": "cultural",
  "start_date": "2026-04-14T18:00:00Z",
  "location_name": "Dallas Convention Center",
  "metro_area_id": "19100",
  "is_global": false,
  "organizer_id": "user-uuid-1",
  "rsvp_count": 42,
  "rsvp_visibility": "public",
  "status": "active"
}
```

