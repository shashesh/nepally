{
  "name": "nepally-monorepo",
  "version": "1.0.0",
  "private": true,
  "description": "Nepally - US Nepal Help Network monorepo",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "mobile": "npm run start --workspace=apps/mobile",
    "web": "npm run dev --workspace=apps/web",
    "test": "npm run docs:test && npm run guards:test && npm run test --workspaces --if-present",
    "test:ci": "npm run guards:test && npm run test:ci --workspace=apps/mobile && npm run test --workspace=apps/web && npm run test --workspace=packages/shared",
    "test:watch": "npm run test:watch --workspaces --if-present",
    "test:coverage": "npm run test:coverage --workspaces --if-present",
    "test:coverage:ci": "npm run guards:test && npm run test:coverage:ci --workspace=apps/mobile && npm run test:coverage --workspace=apps/web && npm run test:coverage --workspace=packages/shared",
    "test:e2e": "npm run test:e2e --workspaces --if-present",
    "test:e2e:web": "npm run test:e2e --workspace=apps/web",
    "test:e2e:web:headed": "npm run test:e2e --workspace=apps/web -- --headed",
    "test:e2e:web:ui": "npm run test:e2e:ui --workspace=apps/web",
    "test:e2e:web:report": "npm run test:e2e --workspace=apps/web -- --reporter=html && npm exec --workspace=apps/web playwright show-report",
    "test:visual:web": "npm run test:visual:docker --workspace=apps/web",
    "test:e2e:mobile": "npm run test:e2e --workspace=apps/mobile",
    "test:security:chat-rls": "tsx scripts/security/chat-rls-smoke.ts",
    "test:security:users-privilege": "tsx scripts/security/users-privilege-smoke.ts",
    "test:security:users-pii": "tsx scripts/security/users-pii-smoke.ts",
    "test:security:emergency-post": "tsx scripts/security/emergency-post-smoke.ts",
    "test:security:storage": "tsx scripts/security/storage-rls-smoke.ts",
    "test:security:functions": "tsx scripts/security/function-execute-smoke.ts",
    "test:security:listing-counters": "tsx scripts/security/listing-counters-smoke.ts",
    "ci:local": "node scripts/run-ci-local.js",
    "lint": "npm run lint --workspaces && npm run lint:md",
    "lint:md": "markdownlint-cli2 && prettier --check \"**/*.md\"",
    "lint:guards": "node scripts/guard-no-catch-any.js && node scripts/guard-css-tokens.js",
    "docs:check": "node scripts/docs/cli.js",
    "docs:test": "node --test \"scripts/docs/*.test.js\"",
    "guards:test": "node --test \"scripts/*.test.js\" \"scripts/ci/*.test.js\"",
    "format": "prettier --write \"**/*.{js,jsx,ts,tsx,json,md}\"",
    "type-check": "npm run type-check --workspaces",
    "clean": "npm run clean --workspaces && rm -rf node_modules",
    "seed:metro": "tsx --env-file=scripts/.env scripts/seed-metro-data.ts"
  },
  "overrides": {
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "ts-api-utils": "2.4.0",
    "vite": "^7",
    "eslint": "$eslint",
    "eslint-plugin-react": {
      "eslint": "$eslint"
    }
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@typescript/native": "npm:typescript@^7.0.2",
    "@vitest/coverage-v8": "^4.1.11",
    "eslint": "^10.10.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^16.5.0",
    "husky": "^9.0.10",
    "markdownlint-cli2": "^0.23.3",
    "prettier": "^3.2.5",
    "tsx": "^4.23.13",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "typescript-eslint": "^8.70.0",
    "vite-tsconfig-paths": "^6.1.1",
    "vitest": "^4.1.11"
  },
  "engines": {
    "node": "^22.13.0 || ^24.3.0 || >=25.0.0",
    "npm": ">=10.0.0"
  }
}
