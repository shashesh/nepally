{
  "name": "nusa-monorepo",
  "version": "1.0.0",
  "private": true,
  "description": "NUSA - Nepalese United Support Alliance monorepo",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "mobile": "npm run start --workspace=apps/mobile",
    "web": "npm run dev --workspace=apps/web",
    "test": "npm run test --workspaces --if-present",
    "test:watch": "npm run test:watch --workspaces --if-present",
    "test:coverage": "npm run test:coverage --workspaces --if-present",
    "test:e2e": "npm run test:e2e --workspaces --if-present",
    "test:e2e:web": "npm run test:e2e --workspace=apps/web",
    "test:e2e:web:headed": "npm run test:e2e --workspace=apps/web -- --headed",
    "test:e2e:web:ui": "npm run test:e2e:ui --workspace=apps/web",
    "test:e2e:web:report": "npm run test:e2e --workspace=apps/web -- --reporter=html && npm exec --workspace=apps/web playwright show-report",
    "test:e2e:mobile": "npm run test:e2e --workspace=apps/mobile",
    "ci:local": "node scripts/run-ci-local.js",
    "lint": "npm run lint --workspaces",
    "lint:guards": "node scripts/guard-no-catch-any.js",
    "format": "prettier --write \"**/*.{js,jsx,ts,tsx,json,md}\"",
    "type-check": "npm run type-check --workspaces",
    "clean": "npm run clean --workspaces && rm -rf node_modules",
    "seed:metro": "tsx --env-file=scripts/.env scripts/seed-metro-data.ts"
  },
  "overrides": {
    "react": "19.1.4",
    "react-dom": "19.1.4",
    "ts-api-utils": "2.4.0"
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^8.56.1",
    "@typescript-eslint/parser": "^8.56.1",
    "@vitest/coverage-v8": "^3.2.4",
    "eslint": "^8.56.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-react": "^7.33.2",
    "eslint-plugin-react-hooks": "^4.6.0",
    "husky": "^9.0.10",
    "prettier": "^3.2.5",
    "tsx": "^4.19.0",
    "typescript": "^5.3.3",
    "vite-tsconfig-paths": "^5.1.4",
    "vitest": "^3.2.4"
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=9.0.0"
  }
}
