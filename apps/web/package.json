{
  "name": "@nepally/web",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test --project=chromium",
    "test:e2e:ui": "playwright test --ui --project=chromium",
    "test:visual": "playwright test --project=visual-desktop --project=visual-phone",
    "test:visual:update": "playwright test --project=visual-desktop --project=visual-phone --update-snapshots",
    "test:visual:docker": "node ../../scripts/visual/run-in-docker.mjs",
    "test:visual:smoke": "node ../../scripts/visual/smoke.mjs",
    "lint": "eslint .",
    "type-check": "node ../../node_modules/@typescript/native/bin/tsc --noEmit"
  },
  "dependencies": {
    "@mantine/core": "^8.3.18",
    "@mantine/form": "^8.3.18",
    "@mantine/hooks": "^8.3.18",
    "@mantine/notifications": "^8.3.18",
    "@nepally/shared": "*",
    "@supabase/supabase-js": "^2.43.0",
    "@tabler/icons-react": "^3.40.0",
    "next": "^16.2.7",
    "postcss": "^8.4.31",
    "postcss-preset-mantine": "^1.18.0",
    "postcss-simple-vars": "^7.0.1",
    "react": "19.1.4",
    "react-dom": "19.1.4"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.49.0",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.2.0",
    "@types/culori": "^4.0.1",
    "@types/node": "^24.13.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@typescript/native": "npm:typescript@^7.0.2",
    "culori": "^4.0.2",
    "eslint": "^10.10.0",
    "eslint-config-next": "^16.3.4",
    "jsdom": "^29.1.1",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "typescript-eslint": "^8.70.0"
  }
}
