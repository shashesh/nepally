# Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Web Push (VAPID)
# Public key only — the matching private key belongs in Supabase secrets
# (VAPID_PRIVATE_KEY), never in this app. Generate a pair with:
#   npx web-push generate-vapid-keys
# See docs/architecture/supabase-setup.md §4.1 for the full setup.
# Leave unset to disable web push; webPush.ts warns and no-ops.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=your-vapid-public-key
