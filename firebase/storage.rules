rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isImage() {
      return request.resource.contentType.matches('image/.*');
    }

    function isValidSize() {
      // Max 10MB for images
      return request.resource.size < 10 * 1024 * 1024;
    }

    // User profile photos
    match /users/{userId}/profile/{fileName} {
      // Anyone can read profile photos
      allow read: if true;

      // Users can upload their own profile photo
      allow write: if isAuthenticated()
                   && request.auth.uid == userId
                   && isImage()
                   && isValidSize();
    }

    // Post photos
    match /posts/{postId}/{fileName} {
      // Anyone can read post photos
      allow read: if true;

      // Authenticated users can upload post photos
      allow write: if isAuthenticated()
                   && isImage()
                   && isValidSize();
    }

    // Chat message images
    match /conversations/{conversationId}/messages/{messageId}/{fileName} {
      // TODO: Add participant check (requires Firestore query in rules, which is expensive)
      // For now, authenticated users can read
      allow read: if isAuthenticated();

      // Authenticated users can upload message images
      allow write: if isAuthenticated()
                   && isImage()
                   && isValidSize();
    }
  }
}
