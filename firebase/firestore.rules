rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isUser(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function getTrustLevel() {
      return getUserData().trustLevel;
    }

    function isModerator() {
      return isAuthenticated() && getUserData().isModerator == true;
    }

    function isVerified() {
      return isAuthenticated() && getTrustLevel() >= 1;
    }

    // Users collection
    match /users/{userId} {
      // Anyone can read public user profiles
      allow read: if true;

      // Users can create their own profile during signup
      allow create: if isUser(userId);

      // Users can update their own profile
      allow update: if isUser(userId);

      // Only moderators can delete users
      allow delete: if isModerator();
    }

    // Posts collection
    match /posts/{postId} {
      // Anyone can read active posts
      allow read: if resource.data.status == 'active';

      // Verified users (trust level 1+) can create posts
      allow create: if isVerified()
                    && request.resource.data.authorId == request.auth.uid
                    && request.resource.data.status == 'active';

      // Post authors can update their own posts
      allow update: if isUser(resource.data.authorId)
                    || isModerator();

      // Post authors and moderators can delete posts
      allow delete: if isUser(resource.data.authorId)
                    || isModerator();
    }

    // Conversations collection
    match /conversations/{conversationId} {
      // Only participants can read conversations
      allow read: if isAuthenticated()
                  && request.auth.uid in resource.data.participants;

      // Verified users can create conversations
      allow create: if isVerified()
                    && request.auth.uid in request.resource.data.participants;

      // Participants can update conversations (for last message, etc.)
      allow update: if isAuthenticated()
                    && request.auth.uid in resource.data.participants;

      // Messages subcollection
      match /messages/{messageId} {
        // Only conversation participants can read messages
        allow read: if isAuthenticated()
                    && request.auth.uid in get(/databases/$(database)/documents/conversations/$(conversationId)).data.participants;

        // Only participants can send messages
        allow create: if isAuthenticated()
                      && request.auth.uid in get(/databases/$(database)/documents/conversations/$(conversationId)).data.participants
                      && request.resource.data.senderId == request.auth.uid;

        // Message sender can update their own messages (for edits)
        allow update: if isUser(resource.data.senderId);

        // Message sender can delete their own messages
        allow delete: if isUser(resource.data.senderId);
      }
    }

    // Reports collection
    match /reports/{reportId} {
      // Only moderators can read reports
      allow read: if isModerator();

      // Verified users can create reports
      allow create: if isVerified()
                    && request.resource.data.reportedBy == request.auth.uid;

      // Only moderators can update reports (change status)
      allow update: if isModerator();

      // Only moderators can delete reports
      allow delete: if isModerator();
    }

    // Metro Areas collection (read-only)
    match /metroAreas/{metroAreaId} {
      allow read: if true;
      allow write: if false; // Only admins can modify via console
    }
  }
}
